# One-stop setup: `cp .env.example .env` and fill in, or run scripts/create_app_registration.sh,
# which writes the AZURE_* and API_* values below for you. Placeholders only; never commit .env.

# --- Required (script fills these) ---
# Directory (tenant) ID of your Entra tenant. Portal: Entra ID > Overview.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the MCP server's app registration.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret of that app registration (Certificates & secrets).
AZURE_CLIENT_SECRET=replace-me

# --- Optional ---
# Public URL of the MCP server. The browser redirect (/auth/callback) and MCP client use it, so
# keep localhost:8000 for Docker too, and match the redirect URI in the app registration.
BASE_URL=http://localhost:8000

# Downstream API (downstream_api.py). Leave both unset for the Graph-only tools.
# Client ID of the API's app registration (script fills it). Compose always starts the API, so
# without this it falls back to a placeholder ID there; the MCP server stays Graph-only.
# API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Where the MCP server reaches the API. Bare metal: http://localhost:8001.
# Docker Compose overrides this with http://downstream-api:8001.
# DOWNSTREAM_API_URL=http://localhost:8001
# Delegated scope on the API (server.py and downstream_api.py both read it). Default: Data.Read.
# API_SCOPE=Data.Read
# downstream_api.py only; defaults to AZURE_TENANT_ID.
# API_TENANT_ID=00000000-0000-0000-0000-000000000000
# downstream_api.py only: comma-separated client IDs allowed to call it (the token's `azp`).
# Unset = any app in the tenant with a Data.Read token for the API. Set it to AZURE_CLIENT_ID
# (the script does).
# ALLOWED_CLIENT_IDS=00000000-0000-0000-0000-000000000000
# Bind address; default 127.0.0.1. Compose sets 0.0.0.0 inside the containers.
# HOST=127.0.0.1
# Where FastMCP keeps its OAuth proxy storage. Default: your OS user data dir for "fastmcp".
# Bare metal only; the image sets /data (a volume), so don't set it here for Docker.
# FASTMCP_HOME=/path/to/fastmcp-home
